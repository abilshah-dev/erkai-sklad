# Скопируйте этот файл в .env и заполните. У каждого клиента свой .env.
# Комментарии пишите только на отдельных строках (systemd не понимает комментарии после значения).

COMPANY_NAME=Название компании

# Токен бота клиента от @BotFather
BOT_TOKEN=123456:ABC

# Telegram ID владельца (узнать у @userinfobot) — он регистрируется без приглашения
OWNER_TG_ID=0

# База клиента на нашем сервере (создаётся скриптом deploy/new_client.sh)
DATABASE_URL=postgresql://sklad_client1:ПАРОЛЬ@127.0.0.1:5432/sklad_client1

# Адрес Mini App: https и слеш на конце
WEBAPP_URL=https://sklad.erkai.kg/client1/

# Порт у каждого клиента свой: 8081, 8082, ...
HOST=127.0.0.1
PORT=8081
